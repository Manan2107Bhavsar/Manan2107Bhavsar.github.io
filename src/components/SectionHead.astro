---
// Section heading. The heading carries its own weight: no label above it.
interface Props { title: string; id?: string; as?: 'h1' | 'h2' }
const { title, id, as = 'h2' } = Astro.props;
const Tag = as;
const long = title.length > 24;
---
<div class:list={['section-head', { 'section-head--long': long }]} data-reveal>
  <Tag id={id}>{title}</Tag>
  <slot />
</div>

<style>
  .section-head { margin-bottom: var(--space-4); max-width: 60rem; }
  .section-head :global(h1) { font-size: var(--step-5); line-height: 0.98; margin-bottom: var(--space-3); }
  .section-head--long :global(h1) { font-size: var(--step-4); line-height: 1.02; }
  .section-head :global(p) { color: var(--ink-2); font-size: 1.1rem; max-width: 52ch; }
</style>
