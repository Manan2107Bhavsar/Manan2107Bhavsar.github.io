---
// Museum wall label with a project's facts. Every project page opens with one.
interface Field { k: string; v: string }
interface Props { fields: Field[]; sheet?: string }
const { fields, sheet } = Astro.props;
---
<dl class="facts wall-label" aria-label="Project details">
  {fields.map((f) => (
    <div class="facts__row">
      <dt>{f.k}</dt>
      <dd>{f.v}</dd>
    </div>
  ))}
  {sheet && (
    <div class="facts__row">
      <dt>Exhibit</dt>
      <dd class="num">{sheet}</dd>
    </div>
  )}
</dl>

<style>
  .facts { margin: 0; padding: 0.4rem 1.25rem; display: grid; }
  .facts__row { display: grid; grid-template-columns: 7.5rem minmax(0, 1fr); gap: 1rem; padding: 0.7rem 0; border-top: 1px solid var(--line); margin: 0; }
  .facts__row:first-child { border-top: 0; }
  dt { font-size: 0.85rem; color: var(--ink-3); }
  dd { margin: 0; font-size: 0.95rem; color: var(--ink); }
</style>
