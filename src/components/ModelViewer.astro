---
// Interactive 3D viewer (Google <model-viewer>).
// The model only downloads when the visitor clicks "View in 3D", so pages stay fast.
interface Props {
  src: string;          // /models/xyz.glb
  poster?: string;      // /posters/xyz.webp
  alt: string;
  sizeMB?: number;      // shown on the load button
  cameraOrbit?: string; // e.g. "35deg 70deg auto"
  autoLoad?: boolean;   // load immediately (used on the home hero)
  height?: string;
}
const { src, poster, alt, sizeMB, cameraOrbit = '35deg 70deg auto', autoLoad = false, height = 'min(70vh, 620px)' } = Astro.props;
---
<figure class="mv" style={`--mv-h:${height}`}>
  <model-viewer
    src={src}
    poster={poster}
    alt={alt}
    camera-controls
    touch-action="pan-y"
    auto-rotate
    auto-rotate-delay="2500"
    rotation-per-second="14deg"
    interaction-prompt="auto"
    camera-orbit={cameraOrbit}
    shadow-intensity="0.7"
    shadow-softness="0.9"
    exposure="1.05"
    environment-image="neutral"
    loading={autoLoad ? 'eager' : 'lazy'}
    reveal={autoLoad ? 'auto' : 'manual'}
    data-orbit={cameraOrbit}
  >
    {!autoLoad && (
      <div {...{ slot: 'poster' }} class="mv__poster" style={poster ? `background-image:url(${poster})` : undefined}>
        <button class="btn mv__load" type="button">
          <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2 3 7v10l9 5 9-5V7l-9-5Zm0 2.3L18.6 8 12 11.7 5.4 8 12 4.3ZM5 9.7l6 3.4v6.6l-6-3.4V9.7Zm8 10v-6.6l6-3.4v6.6l-6 3.4Z" fill="currentColor"/></svg>
          View in 3D{sizeMB ? ` · ${sizeMB.toFixed(1)} MB` : ''}
        </button>
      </div>
    )}
    <div {...{ slot: 'progress-bar' }} class="mv__progress"><span></span></div>
  </model-viewer>
  <div class="mv__bar">
    <span class="label mv__hint">Drag to orbit · scroll or pinch to zoom · right-drag to pan</span>
    <span class="mv__actions">
      <button type="button" class="mv__btn" data-act="reset">Reset view</button>
      <button type="button" class="mv__btn" data-act="full">Full screen</button>
    </span>
  </div>
</figure>

<script>
  import '@google/model-viewer';
  // Self-hosted Draco decoder (models are Draco-compressed), so nothing loads from a CDN.
  customElements.whenDefined('model-viewer').then(() => {
    const MV: any = customElements.get('model-viewer');
    if (MV) MV.dracoDecoderLocation = '/decoders/draco/';
  });

  document.querySelectorAll<HTMLElement>('figure.mv').forEach((fig) => {
    const mv = fig.querySelector('model-viewer') as any;
    fig.querySelector('.mv__load')?.addEventListener('click', () => mv.dismissPoster());
    mv.addEventListener('progress', (e: any) => {
      const bar = fig.querySelector<HTMLElement>('.mv__progress span');
      if (bar) bar.style.width = `${Math.round(e.detail.totalProgress * 100)}%`;
      fig.classList.toggle('is-loading', e.detail.totalProgress < 1);
    });
    fig.querySelectorAll<HTMLButtonElement>('.mv__btn').forEach((b) => b.addEventListener('click', () => {
      if (b.dataset.act === 'reset') {
        mv.cameraOrbit = mv.dataset.orbit; mv.cameraTarget = 'auto auto auto'; mv.fieldOfView = 'auto';
        mv.jumpCameraToGoal?.();
      } else if (b.dataset.act === 'full') {
        if (document.fullscreenElement) document.exitFullscreen();
        else fig.requestFullscreen?.();
      }
    }));
  });
</script>

<style>
  .mv { margin: 0; border: 1px solid var(--line-strong); background: var(--paper-2); }
  model-viewer {
    width: 100%; height: var(--mv-h);
    background-color: transparent;
    --poster-color: transparent;
    background-image:
      linear-gradient(var(--grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 24px 24px;
  }
  .mv:fullscreen { display: flex; flex-direction: column; background: var(--paper-2); }
  .mv:fullscreen model-viewer { flex: 1; height: auto; }
  .mv__poster {
    position: absolute; inset: 0; display: grid; place-items: center;
    background-size: contain; background-position: center; background-repeat: no-repeat;
  }
  .mv__load { box-shadow: 0 1px 0 rgba(0,0,0,0.05); }
  .mv__progress { position: absolute; left: 0; right: 0; bottom: 0; height: 3px; }
  .mv:not(.is-loading) .mv__progress { opacity: 0; }
  .mv__progress span { display: block; height: 100%; width: 0; background: var(--accent); transition: width 0.2s; }
  .mv__bar { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 0.5rem; padding: 0.5rem 0.75rem; border-top: 1px solid var(--line); background: var(--paper); }
  .mv__actions { display: flex; gap: 0.4rem; }
  .mv__btn { font: 500 0.8rem/1 var(--font-mono); color: var(--ink-2); background: none; border: 1px solid var(--line); border-radius: 2px; padding: 0.45rem 0.6rem; cursor: pointer; }
  .mv__btn:hover { color: var(--accent-ink); border-color: var(--accent); }
  @media (max-width: 600px) { .mv__hint { display: none; } }
</style>
