---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** Lets the home hero run under a transparent header. */
  overlayHeader?: boolean;
}
const {
  title,
  description = 'Manan Bhavsar: Engineering Design & Drafting Technology student at Saskatchewan Polytechnic. Civil, mechanical and architectural drafting, 3D models you can explore, and the tools I build to speed up drafting.',
  image,
  overlayHeader = false,
} = Astro.props;
const fullTitle = title ? `${title} · Manan Bhavsar` : 'Manan Bhavsar · Drafting & Design';
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image ?? '/posters/pump-base.webp', Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#f3f3f0" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="author" content="Manan Bhavsar" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header overlay={overlayHeader} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>import '../scripts/reveal.ts';</script>
  </body>
</html>
