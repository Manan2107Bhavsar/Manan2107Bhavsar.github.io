---
import Base from '../layouts/Base.astro';

const rooms = [
  { href: '/', label: 'Home' },
  { href: '/projects/', label: 'Projects' },
  { href: '/work/', label: 'Co-op work' },
  { href: '/side-projects/', label: 'Side projects' },
  { href: '/about/', label: 'About' },
  { href: '/resume/', label: 'Resume' },
];
---
<Base title="Page not found" description="This page doesn't exist on Manan Bhavsar's portfolio.">
  <section class="wrap nf">
    <h1>This page isn’t here.</h1>
    <p class="lede">It may have moved, or the link has a typo. Try one of these instead.</p>
    <nav class="nf__rooms" aria-label="Pages on this site">
      <ul>
        {rooms.map((r) => <li><a href={r.href}>{r.label}<span aria-hidden="true">→</span></a></li>)}
      </ul>
    </nav>
  </section>
</Base>

<style>
  .nf { padding-block: var(--space-6) var(--space-5); }
  .nf h1 { font-size: var(--step-5); line-height: 0.98; max-width: 12ch; }
  .nf__rooms ul { list-style: none; padding: 0; margin: var(--space-4) 0 0; max-width: 32rem; border-top: 2px solid var(--ink); }
  .nf__rooms li { margin: 0; border-bottom: 1px solid var(--line); }
  .nf__rooms a { display: flex; justify-content: space-between; padding: 0.9rem 0; color: var(--ink); text-decoration: none; font-size: 1.1rem; transition: color 0.2s, padding 0.35s var(--ease-out); }
  .nf__rooms a:hover { color: var(--accent); padding-left: 0.4rem; }
</style>
