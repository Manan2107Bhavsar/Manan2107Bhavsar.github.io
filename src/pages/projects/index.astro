---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const projects = (await getCollection('projects', (p) => p.data.kind === 'academic')).sort((a, b) => a.data.order - b.data.order);
const filters = ['Civil', 'Mechanical', 'Architectural', 'Structural'] as const;
const count = (d: string) => projects.filter((p) => p.data.discipline === d).length;
const lede = "Coursework from Saskatchewan Polytechnic's Engineering Design & Drafting Technology program. Models marked 3D can be rotated in your browser; no software needed.";
---
<Base title="Projects" description={lede}>
  <section class="wrap section">
    <SectionHead as="h1" label="EDDT coursework" title="Projects" />
    <p class="lede">{lede}</p>

    <div class="filters" role="group" aria-label="Filter projects by discipline" data-filters hidden>
      <button type="button" class="filter" data-filter="All" aria-pressed="true">All <span class="filter__n">{projects.length}</span></button>
      {filters.map((d) => (
        <button type="button" class="filter" data-filter={d} aria-pressed="false">{d} <span class="filter__n">{count(d)}</span></button>
      ))}
    </div>
    <p class="visually-hidden" aria-live="polite" data-status></p>

    <ul class="grid" role="list">
      {projects.map((p) => (
        <li data-discipline={p.data.discipline}><ProjectCard project={p} headingLevel="h2" /></li>
      ))}
    </ul>
    <p class="muted empty" data-empty hidden>No projects in this discipline yet.</p>
  </section>
</Base>

<script>
  const bar = document.querySelector<HTMLElement>('[data-filters]');
  const items = Array.from(document.querySelectorAll<HTMLLIElement>('.grid > li'));
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
  const status = document.querySelector<HTMLElement>('[data-status]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');

  function apply(filter: string, updateUrl: boolean) {
    const known = buttons.some((b) => b.dataset.filter === filter);
    const f = known ? filter : 'All';
    let shown = 0;
    items.forEach((li) => {
      const show = f === 'All' || li.dataset.discipline === f;
      li.hidden = !show;
      if (show) shown++;
    });
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === f)));
    if (empty) empty.hidden = shown > 0;
    if (status) status.textContent = `Showing ${shown} ${shown === 1 ? 'project' : 'projects'}${f === 'All' ? '' : ` in ${f}`}.`;
    if (updateUrl) {
      const url = new URL(location.href);
      if (f === 'All') url.searchParams.delete('d'); else url.searchParams.set('d', f);
      history.replaceState(null, '', url);
    }
  }

  if (bar) {
    bar.hidden = false; // filters only appear when JS runs; without JS every card stays visible
    buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.filter || 'All', true)));
    const d = new URLSearchParams(location.search).get('d');
    if (d) {
      const match = buttons.find((b) => b.dataset.filter?.toLowerCase() === d.toLowerCase());
      apply(match?.dataset.filter || 'All', false);
    }
  }
</script>

<style>
  .lede { margin-bottom: var(--space-3); }
  .filters { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: var(--space-3); }
  .filters[hidden] { display: none; }
  .filter {
    font: 500 0.9rem/1 var(--font-sans);
    padding: 0.6em 0.9em;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s, background 0.15s;
  }
  .filter:hover { border-color: var(--accent); color: var(--accent-ink); }
  .filter[aria-pressed='true'] { background: var(--ink); border-color: var(--ink); color: var(--paper); }
  .filter__n { font-family: var(--font-mono); font-size: 0.78em; opacity: 0.75; margin-left: 0.2em; }
  .grid { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-3); grid-template-columns: 1fr; }
  .grid > li { margin: 0; }
  .grid > li[hidden] { display: none; }
  @media (min-width: 640px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 980px) { .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .empty { margin-top: var(--space-3); }
</style>
