---
import { getCollection, render } from 'astro:content';
import ProjectLayout from '../../layouts/ProjectLayout.astro';

export async function getStaticPaths() {
  const all = (await getCollection('projects', (p) => p.data.kind === 'academic')).sort((a, b) => a.data.order - b.data.order);
  return all.map((project, i) => ({ params: { slug: project.id }, props: { project, sheet: `${i + 1} of ${all.length}` } }));
}
const { project, sheet } = Astro.props;
const { Content } = await render(project);
---
<ProjectLayout project={project} sheet={sheet}><Content /></ProjectLayout>
