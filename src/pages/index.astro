---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';

type P = CollectionEntry<'projects'>;
const all = await getCollection('projects');
const academic = all.filter((p) => p.data.kind === 'academic').sort((a, b) => a.data.order - b.data.order);
const side = all.filter((p) => p.data.kind === 'side').sort((a, b) => a.data.order - b.data.order);
const byId = (id: string) => all.find((p) => p.id === id);

// The floor: two large exhibits, then the rest in a row. The pump base already stands in the hero.
const large = ['mechanical-building', 'storm-network'].map(byId).filter((p): p is P => Boolean(p));
const row = academic.filter((p) => p.id !== 'pump-base' && !large.includes(p)).slice(0, 4);

const count = (d: string) => academic.filter((p) => p.data.discipline === d).length;
const rooms = {
  mech: count('Mechanical'),
  arch: count('Architectural'),
  struct: count('Structural'),
  civil: count('Civil'),
  side: side.length,
};
const plural = (n: number, w: string) => `${n} ${w}${n === 1 ? '' : 's'}`;

const steps = [
  {
    text: 'A three-phase AC motor drives an end-suction centrifugal pump through a flexible shaft coupling.',
    meta: 'Autodesk Inventor 2027 · Fall 2026',
  },
  {
    text: 'The base frame is a weldment of 11 plate parts, set on a concrete foundation with a grout pad.',
    meta: 'Weldment · foundation assembly',
  },
  {
    text: 'A 23-sheet drawing set, with every part numbered in one scheme.',
    meta: 'General arrangement · details · exploded views',
  },
];
---
<Base
  overlayHeader
  description="Manan Bhavsar: drafting and design student at Saskatchewan Polytechnic. Civil, mechanical and architectural projects you can turn in 3D, three co-op terms with the City of Saskatoon, and the tools I build to make drafting faster."
>
  <!-- First viewport: the pump base on a plinth in window light. Scrolling turns it. -->
  <section class="hero" aria-labelledby="hero-title" data-hero>
    <div class="hero__light" aria-hidden="true">
      <div class="hero__scene" data-unicorn></div>
    </div>

    <div class="wrap hero__grid">
      <div class="hero__text">
        <h1 id="hero-title" class="hero__name"><span>Manan</span> <span>Bhavsar</span></h1>
        <p class="hero__statement">I draft civil, mechanical and architectural projects, and I build the tools that make drafting faster.</p>
        <p class="hero__program">
          Engineering Design &amp; Drafting Technology, Saskatchewan Polytechnic, graduating April 2027.
          Three co-op terms as a Drafting Student with the City of Saskatoon.
        </p>
        <div class="btn-row hero__actions">
          <a class="btn" href="#exhibits">See my projects</a>
          <a class="text-link" href="#contact">Email me</a>
        </div>
      </div>

      <div class="hero__exhibit">
        <div class="hero__model">
          <model-viewer
            data-hero-model
            src="/models/pump-base.glb"
            poster="/posters/pump-base.webp"
            alt="3D model of my pump base assembly: motor, coupling and pump on a welded steel base"
            camera-orbit="30deg 72deg 105%"
            interpolation-decay="90"
            shadow-intensity="0.9"
            shadow-softness="1"
            exposure="1.05"
            environment-image="neutral"
            disable-zoom
            disable-pan
            interaction-prompt="none"
            loading="eager"
          ></model-viewer>
        </div>
        <div class="hero__plinth" aria-hidden="true"></div>

        <aside class="hero__label wall-label" aria-label="About this exhibit">
          <p class="wall-label__title">Pump Base</p>
          <div class="hero__steps">
            {steps.map((s, i) => (
              <div class="hero__step" data-step={i} aria-hidden={i > 0 ? 'true' : undefined}>
                <p class="wall-label__text">{s.text}</p>
                <p class="wall-label__meta">{s.meta}</p>
              </div>
            ))}
          </div>
          <p class="hero__scrollnote" aria-hidden="true">Scroll to turn it</p>
          <div class="hero__progress" aria-hidden="true">
            {steps.map(() => <span><i></i></span>)}
          </div>
          <a class="hero__more" href="/projects/pump-base/">Turn it in 3D<span aria-hidden="true"> →</span></a>
        </aside>
      </div>
    </div>
  </section>

  <!-- The plan of the exhibition, as navigation -->
  <section class="wrap plan" aria-labelledby="plan-title">
    <div class="plan__text" data-reveal>
      <h2 id="plan-title">Six rooms of real work.</h2>
      <p>
        Coursework and tools that exist: 3D models you can turn in your browser, full drawing sets, and the software
        I built along the way. Pick a room on the plan.
      </p>
    </div>
    <svg class="plan__svg" viewBox="0 0 760 360" role="img" aria-labelledby="plan-svg-title" data-plan>
      <title id="plan-svg-title">Floor plan of the portfolio with six rooms</title>
      <rect class="plan__outer" x="6" y="6" width="748" height="348" pathLength="1" />
      <g class="plan__walls">
        <path d="M260 6V120M260 170V354M500 6V120M500 170V354M6 180H190M240 180H430M480 180H690M740 180H754" pathLength="1" />
      </g>

      <a href="/projects/?d=Mechanical" class="room"><rect x="20" y="20" width="226" height="146" /><text x="36" y="58" class="room__name">Mechanical</text><text x="36" y="86" class="room__note">{plural(rooms.mech, 'exhibit')} · Inventor</text></a>
      <a href="/projects/?d=Architectural" class="room"><rect x="274" y="20" width="212" height="146" /><text x="290" y="58" class="room__name">Architectural</text><text x="290" y="86" class="room__note">{plural(rooms.arch, 'exhibit')} · Revit</text></a>
      <a href="/projects/?d=Structural" class="room"><rect x="514" y="20" width="226" height="146" /><text x="530" y="58" class="room__name">Structural</text><text x="530" y="86" class="room__note">{plural(rooms.struct, 'exhibit')}</text></a>
      <a href="/projects/?d=Civil" class="room"><rect x="20" y="194" width="226" height="146" /><text x="36" y="232" class="room__name">Civil</text><text x="36" y="260" class="room__note">{plural(rooms.civil, 'exhibit')} · Civil 3D</text></a>
      <a href="/work/" class="room room--accent"><rect x="274" y="194" width="212" height="146" /><text x="290" y="232" class="room__name">Co-op work</text><text x="290" y="260" class="room__note">3 tools, City of Saskatoon</text></a>
      <a href="/side-projects/" class="room"><rect x="514" y="194" width="226" height="146" /><text x="530" y="232" class="room__name">Side projects</text><text x="530" y="260" class="room__note">{plural(rooms.side, 'project')}</text></a>
      <g class="plan__doors" aria-hidden="true">
        <!-- door leaf (open 90°) plus its swing arc, drawn like a plan symbol -->
        <path class="leaf" d="M260 170H310M500 170H450M240 180V230M480 180V230M740 180V230" />
        <path class="swing" d="M310 170A50 50 0 0 0 260 120M450 170A50 50 0 0 1 500 120M240 230A50 50 0 0 1 190 180M480 230A50 50 0 0 1 430 180M740 230A50 50 0 0 1 690 180" />
      </g>
    </svg>
  </section>

  <!-- Exhibits -->
  <section id="exhibits" class="wrap floor" aria-labelledby="floor-title">
    <div class="floor__head" data-reveal>
      <h2 id="floor-title">Projects</h2>
      <a class="text-link" href="/projects/">See all {academic.length} projects</a>
    </div>
    <div class="floor__large">
      {large.map((p) => <ProjectCard project={p} size="large" group="large" />)}
    </div>
    <div class="floor__row">
      {row.map((p) => <ProjectCard project={p} group="row" />)}
    </div>
  </section>

  <!-- Co-op -->
  <section class="coop" aria-labelledby="coop-title" data-coop>
    <div class="wrap">
      <div class="coop__head" data-reveal>
        <h2 id="coop-title">Co-op work at the City of Saskatoon</h2>
        <p>
          Three work terms as a Drafting Student in Construction &amp; Design, 2025 to 2026. The everyday drafting
          came first. These are the tools I built when a task kept repeating.
        </p>
      </div>

      <div class="coop__tools">
        <article class="tool" data-reveal data-reveal-group="tools">
          <h3>AutoSlope Labeller</h3>
          <p class="tool__kind">C# .NET plug-in for Civil 3D</p>
          <p class="tool__text">Places slope labels every 5 m along a road alignment. I built it over a weekend, on my own initiative.</p>
          <div class="bars" role="img" aria-label="Per 1 to 2 km road: 15 to 20 minutes by hand, 30 to 45 seconds with the tool.">
            <p class="bars__label">By hand · <span class="num">15–20 min</span></p>
            <div class="bar bar--before"><span style="--w:100%"></span></div>
            <p class="bars__label bars__label--after">With the tool · <span class="num">30–45 s</span></p>
            <div class="bar"><span style="--w:4%"></span></div>
          </div>
          <p class="tool__note">Per 1–2 km road, drawn to scale. Clicks went from a couple hundred to 10–15.</p>
        </article>

        <article class="tool" data-reveal data-reveal-group="tools">
          <h3>Candle</h3>
          <p class="tool__kind">AutoLISP routine</p>
          <p class="tool__text">Draws a manhole in profile from picked points and elevations, on the right layer and style, labelled.</p>
          <div class="bars" role="img" aria-label="Per manhole: about 4 to 5 minutes by hand, under 30 seconds with the tool.">
            <p class="bars__label">By hand · <span class="num">~4–5 min</span></p>
            <div class="bar bar--before"><span style="--w:100%"></span></div>
            <p class="bars__label bars__label--after">With the tool · under <span class="num">30 s</span></p>
            <div class="bar"><span style="--w:11%"></span></div>
          </div>
          <p class="tool__note">Per manhole, drawn to scale.</p>
        </article>

        <article class="tool" data-reveal data-reveal-group="tools">
          <h3>Pipe slope tool</h3>
          <p class="tool__kind">AutoLISP routine</p>
          <p class="tool__text">One click on a water main, sewer or storm pipe in profile:</p>
          <ul class="tool__list">
            <li>Calculates and labels the slope percentage</li>
            <li>Detects the pipe system from its layer</li>
            <li>Flags any line that isn’t on the standard layer</li>
          </ul>
        </article>
      </div>

      <div class="coop__foot" data-reveal>
        <p>
          Built with AI assistance: Claude to plan, an AI coding assistant to generate the code. My part is the problem,
          the logic, finding the right API, testing and debugging in Civil 3D, and fitting each tool to City standards.
          City drawings and tool code stay with the City.
        </p>
        <a class="coop__link" href="/work/">Read the co-op story<span aria-hidden="true"> →</span></a>
      </div>
    </div>
  </section>

  <!-- Side projects -->
  <section class="wrap side" aria-labelledby="side-title">
    <div class="side__head" data-reveal>
      <h2 id="side-title">Side projects</h2>
      <p>Things I build for fun and curiosity, outside my courses.</p>
      <a class="text-link" href="/side-projects/">See all side projects</a>
    </div>
    <div class="side__grid">
      {side.map((p) => <ProjectCard project={p} group="side" />)}
    </div>
  </section>

  <!-- About -->
  <section class="wrap about" aria-labelledby="about-title">
    <div class="about__text" data-reveal>
      <h2 id="about-title">Mechanical training, drafting across disciplines.</h2>
      <p>
        A mechanical engineering diploma and 3D CAD training in India, then Saskatchewan Polytechnic’s drafting
        program, where I work in Revit, Civil 3D and Inventor. My class is the last EDDT cohort.
      </p>
      <p class="btn-row"><a class="text-link" href="/about/">More about me</a><a class="text-link" href="/resume/">Resume</a></p>
    </div>
    <dl class="about__list" data-reveal>
      <div><dt>Certified SolidWorks Professional (CSWP)</dt><dd class="num">Jan 2024</dd></div>
      <div><dt>Autodesk Certified User, AutoCAD</dt><dd class="num">Sep 2023</dd></div>
      <div><dt>Diploma, Mechanical Engineering, GTU</dt><dd class="num">2020–2023</dd></div>
      <div><dt>EDDT, Saskatchewan Polytechnic</dt><dd class="num">2024–2027</dd></div>
    </dl>
  </section>
</Base>

<script>
  import '../scripts/home.ts';
</script>

<style>
  /* ---------- hero ---------- */
  .hero { position: relative; min-height: max(100svh, 720px); display: flex; flex-direction: column; justify-content: flex-end; overflow: hidden; border-bottom: 1px solid var(--line); }
  .hero__light { position: absolute; inset: 0; background: url(/hero/wall-light.webp) 70% 30% / cover no-repeat, var(--wall); transform-origin: 70% 40%; }
  .hero__scene { position: absolute; inset: 0; }
  /* keep the wall in daylight: the shadows lift to a pale grey, never a dark one */
  .hero__light::after { content: ''; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(90deg, rgba(246, 246, 243, 0.72) 0%, rgba(246, 246, 243, 0.62) 45%, rgba(246, 246, 243, 0.5) 100%); }
  .hero__grid { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--space-4); align-items: end; padding-top: 120px; }
  .hero__text { padding-bottom: clamp(4rem, 12vh, 8rem); }
  .hero__name { font-size: clamp(3.2rem, 0.2rem + 6.2vw, 7rem); line-height: 0.9; font-stretch: 125%; font-weight: 780; letter-spacing: -0.04em; margin: 0; }
  .hero__name span { display: block; }
  .hero__statement { font-size: clamp(1.2rem, 1rem + 0.6vw, 1.45rem); line-height: 1.45; color: #2a2e34; max-width: 30ch; margin: var(--space-3) 0 0; }
  .hero__program { font-size: 0.95rem; color: #4f545c; max-width: 44ch; margin: 1rem 0 0; }
  .hero__actions { margin-top: var(--space-4); gap: 1.25rem; }

  .hero__exhibit { position: relative; display: flex; flex-direction: column; align-items: flex-start; }
  .hero__model { position: relative; z-index: 1; width: min(640px, 74%); aspect-ratio: 1 / 1; margin-bottom: -84px; }
  .hero__model model-viewer { width: 100%; height: 100%; --poster-color: transparent; background: transparent; }
  .hero__plinth { width: min(520px, 60%); margin-left: min(60px, 7%); height: clamp(110px, 17vh, 160px); background: linear-gradient(var(--plinth), #f6f6f3); border: 1px solid #e2e2dd; border-bottom: 0; box-shadow: var(--shadow-plinth); }

  .hero__label { position: absolute; right: 0; bottom: clamp(40px, 8vh, 72px); width: 240px; z-index: 2; }
  .hero__scrollnote { margin: 0.9rem 0 0; font-size: 0.78rem; color: var(--ink-3); }
  .hero__steps { display: grid; }
  .hero__step { grid-area: 1 / 1; }
  .hero__step[aria-hidden='true'] { opacity: 0; visibility: hidden; }
  html.js .hero__step { transition: opacity 0.45s var(--ease-out), transform 0.45s var(--ease-out), visibility 0.45s; }
  .hero__progress { display: flex; gap: 4px; margin-top: 0.45rem; }
  .hero__progress span { flex: 1; height: 2px; background: var(--line); overflow: hidden; }
  .hero__progress i { display: block; height: 100%; background: var(--accent); transform: scaleX(var(--p, 0)); transform-origin: left; }
  .hero__more { display: inline-block; margin-top: 0.8rem; font-size: 0.88rem; font-weight: 500; text-decoration: none; }


  /* entrance: the one orchestrated moment on load */
  @media (prefers-reduced-motion: no-preference) {
    html:not(.live-light) .hero__light { animation: drift 40s ease-in-out infinite alternate; }
    html.js .hero__name span { animation: wipe 1.2s var(--ease-in-out) both; }
    html.js .hero__name span + span { animation-delay: 0.12s; }
    html.js .hero__statement, html.js .hero__program, html.js .hero__actions { animation: rise 1.1s var(--ease-out) both; }
    html.js .hero__statement { animation-delay: 0.45s; }
    html.js .hero__program { animation-delay: 0.55s; }
    html.js .hero__actions { animation-delay: 0.65s; }
    html.js .hero__model { animation: rise 1.4s var(--ease-out) 0.25s both; }
    html.js .hero__plinth { animation: rise 1.2s var(--ease-out) 0.1s both; }
    html.js .hero__label { animation: rise 1s var(--ease-out) 0.9s both; }
  }
  @keyframes drift { from { background-position: 62% 28%; } to { background-position: 78% 36%; } }
  @keyframes wipe { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0 0 0 0); } }
  @keyframes rise { from { opacity: 0; transform: translateY(28px); } to { opacity: 1; transform: none; } }

  /* ---------- floor plan ---------- */
  .plan { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: var(--space-5); align-items: center; padding-block: var(--space-6) var(--space-5); }
  .plan h2 { font-size: var(--step-3); }
  .plan p { color: var(--ink-2); font-size: 1.05rem; max-width: 36ch; }
  .plan__svg { width: 100%; height: auto; overflow: visible; }
  .plan__outer { fill: #fafaf8; stroke: var(--ink); stroke-width: 6; }
  .plan__walls path { fill: none; stroke: var(--ink); stroke-width: 3; }
  .plan__doors { pointer-events: none; }
  .plan__doors .leaf { fill: none; stroke: var(--ink); stroke-width: 2.5; }
  .plan__doors .swing { fill: none; stroke: #8d9198; stroke-width: 1.2; }
  .room rect { fill: transparent; transition: fill 0.35s var(--ease-out); }
  .room:hover rect, .room:focus-visible rect { fill: var(--accent-tint); }
  .room--accent rect { fill: var(--accent-tint); }
  .room--accent:hover rect { fill: #d9e0fa; }
  .room__name { font: 600 22px var(--font-sans); fill: var(--ink); }
  .room__note { font: 400 15px var(--font-sans); fill: var(--ink-2); }
  .room--accent .room__name { fill: var(--accent); }
  .room--accent .room__note { fill: #2a3a8c; }
  .room:hover .room__name { fill: var(--accent); }
  .room:focus-visible { outline: none; }
  .room:focus-visible rect { stroke: var(--accent); stroke-width: 2; }

  /* ---------- exhibits ---------- */
  .floor { padding-block: var(--space-5); }
  .floor__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 1rem; margin-bottom: var(--space-5); }
  .floor__head h2 { font-size: var(--step-3); margin: 0; }
  .floor__large { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--space-5); align-items: end; }
  .floor__row { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-4); margin-top: var(--space-6); align-items: end; }

  /* ---------- co-op ---------- */
  .coop { background: var(--accent); color: var(--on-accent); padding-block: var(--space-6); margin-top: var(--space-5); }
  .coop ::selection { background: var(--on-accent); color: var(--accent); }
  .coop :focus-visible { outline-color: var(--on-accent); }
  .coop__head { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); gap: var(--space-5); align-items: end; }
  .coop__head h2 { font-size: var(--step-4); font-stretch: 118%; letter-spacing: -0.03em; margin: 0; }
  .coop__head p { margin: 0; font-size: 1.1rem; color: var(--on-accent-2); max-width: 46ch; }
  .coop__tools { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-4); margin-top: var(--space-5); }
  .tool { border-top: 2px solid var(--on-accent); padding-top: 1.4rem; }
  .tool h3 { margin: 0; font-size: 1.4rem; }
  .tool__kind { margin: 0.3rem 0 0; font-size: 0.88rem; color: var(--on-accent-3); }
  .tool__text { margin: 1.1rem 0 0; color: #e8ecfd; font-size: 1rem; }
  .coop .bars__label { color: var(--on-accent-3); }
  .coop .bars__label--after { color: var(--on-accent); }
  .coop .bar span { background: var(--on-accent); }
  .coop .bar--before span { background: rgba(255, 255, 255, 0.35); }
  .tool__note { margin: 0.9rem 0 0; font-size: 0.85rem; color: var(--on-accent-3); }
  .tool__list { list-style: none; padding: 0; margin: 1rem 0 0; }
  .tool__list li { padding: 0.6rem 0; border-bottom: 1px solid rgba(255, 255, 255, 0.25); margin: 0; }
  .coop__foot { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--space-5); align-items: center; margin-top: var(--space-5); }
  .coop__foot p { margin: 0; color: var(--on-accent-2); font-size: 0.98rem; max-width: 34rem; }
  .coop__link { justify-self: end; color: var(--on-accent); font-weight: 500; text-decoration: none; border-bottom: 1px solid var(--on-accent); padding-bottom: 2px; }
  .coop__link:hover { color: var(--on-accent); border-bottom-width: 2px; }

  /* ---------- side projects ---------- */
  .side { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: var(--space-5); padding-block: var(--space-6) var(--space-4); }
  .side__head h2 { font-size: var(--step-3); }
  .side__head p { color: var(--ink-2); font-size: 1.05rem; max-width: 30ch; }
  .side__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-3); align-items: start; }

  /* ---------- about ---------- */
  .about { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--space-5); padding-block: var(--space-5) 0; }
  .about__text { border-top: 1px solid var(--line-strong); padding-top: var(--space-4); }
  .about__text h2 { font-size: var(--step-3); max-width: 18ch; }
  .about__text > p:first-of-type { font-size: 1.12rem; color: var(--ink-2); max-width: 56ch; }
  .about__text .btn-row { gap: 1.5rem; margin-top: var(--space-3); }
  .about__list { margin: 0; border-top: 1px solid var(--line-strong); padding-top: var(--space-3); }
  .about__list div { display: flex; justify-content: space-between; gap: 1rem; padding: 0.9rem 0; border-bottom: 1px solid var(--line); }
  .about__list dt { color: var(--ink-2); }
  .about__list dd { margin: 0; font-size: 0.88rem; color: var(--ink-3); white-space: nowrap; }

  /* ---------- smaller screens ---------- */
  @media (max-width: 1100px) {
    .floor__row { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .side { grid-template-columns: 1fr; }
  }
  @media (max-width: 900px) {
    .hero { min-height: auto; }
    .hero__grid { grid-template-columns: 1fr; padding-top: 110px; gap: var(--space-3); }
    .hero__text { padding-bottom: 0; }
    .hero__label { position: relative; right: auto; bottom: auto; width: auto; align-self: stretch; margin: 1.25rem 0 var(--space-4); }
    .hero__plinth { height: 70px; }
    .hero__model { margin-bottom: -36px; }
    .hero__progress, .hero__scrollnote { display: none; }
    .hero__exhibit { align-items: center; }
    .hero__model { width: min(520px, 100%); }
    .hero__plinth { width: 78%; margin-left: 0; }
    .hero__step[aria-hidden='true'] { display: none; }
    .plan, .floor__large, .coop__head, .coop__tools, .coop__foot, .about { grid-template-columns: 1fr; gap: var(--space-4); }
